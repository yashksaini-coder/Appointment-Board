# Copy to .env to override. Every value below is already the built-in default.
POSTGRES_USER=appointments
POSTGRES_PASSWORD=appointments
POSTGRES_DB=appointments

DB_PORT=5432    # host port for psql access
API_PORT=8000   # FastAPI (docs at http://localhost:8000/docs)
WEB_PORT=8080   # the board itself

LOG_LEVEL=INFO     # DEBUG raises app + uvicorn verbosity (not SQL)
LOG_FORMAT=console # console for humans, json for log aggregation

# Sample appointments on first boot. Set false in production.
SEED_SAMPLE_DATA=true
